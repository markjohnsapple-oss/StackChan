 function validRoomDrop(clientX,clientY){
  const scene=room();if(!scene)return false;
  const box=scene.getBoundingClientRect();
  if(clientX<box.left||clientX>box.right||clientY<box.top||clientY>box.bottom)return false;
  const xp=(clientX-box.left)/box.width*100,yp=(clientY-box.top)/box.height*100;
  if(yp<20||yp>77||xp<5||xp>95)return false;
  const hit=document.elementFromPoint(clientX,clientY);
  if(hit?.closest('.room-chat,.home-nav,.home-top,.ghost-world-layer,.ghost-placement-hint'))return false;
  return true;
 }
 function placeFromTrunkDrag(id,clientX,clientY){
  const scene=room();if(!scene||!validRoomDrop(clientX,clientY))return false;
  reload();
  if(!(state.items[id]>0)||!catalog[id]||catalog[id].kind==='food'||catalog[id].kind==='clothing')return false;
  const current=scene.closest('#ghost-room-screen')?.dataset.room;if(!current)return false;
  const info=panelInfoForPoint(scene,clientX,clientY);if(!info)return false;
  const box=info.box;
  const x=Math.round((clientX-box.left)/box.width*100),y=Math.round((clientY-box.top)/box.height*100);
  const entry={id,room:current,panel:info.key,x:Math.max(12,Math.min(88,x)),y:Math.max(26,Math.min(72,y))};
  state.items[id]--;state.placed.push(entry);
  if(!save()){state.placed.pop();state.items[id]++;return false}
  learn('toy',id);
  renderPlaced();
  refreshOpenTrunk();
  return true;
 }
 function bindTrunkDragOut(handle,id){
  if(!handle||handle.dataset.dragOutBound)return;
  handle.dataset.dragOutBound='1';
  let down=null,dragging=false,proxy=null;
  const cleanup=()=>{
   try{if(down&&handle.hasPointerCapture?.(down.pointerId))handle.releasePointerCapture(down.pointerId)}catch{}
   down=null;dragging=false;
   proxy?.remove();proxy=null;
   room()?.classList.remove('ghost-trunk-room-drop-ready');
  };
  handle.addEventListener('pointerdown',e=>{
   if(e.button!==undefined&&e.button!==0&&e.pointerType==='mouse')return;
   e.preventDefault();e.stopPropagation();
   down={pointerId:e.pointerId,x:e.clientX,y:e.clientY};
   handle.setPointerCapture?.(e.pointerId);
  });
  handle.addEventListener('pointermove',e=>{
   if(!down||e.pointerId!==down.pointerId)return;
   if(!dragging&&Math.hypot(e.clientX-down.x,e.clientY-down.y)>6){
    dragging=true;
    proxy=document.createElement('div');proxy.className='ghost-trunk-drag-proxy';
    const art=storageArt(id);proxy.append(art);document.body.append(proxy);
   }
   if(!dragging)return;
   e.preventDefault();
   if(proxy){proxy.style.left=e.clientX+'px';proxy.style.top=e.clientY+'px'}
   room()?.classList.toggle('ghost-trunk-room-drop-ready',validRoomDrop(e.clientX,e.clientY));
  });
  handle.addEventListener('pointerup',e=>{
   if(!down||e.pointerId!==down.pointerId)return;
   const wasDragging=dragging;
   if(wasDragging){e.preventDefault();e.stopPropagation();placeFromTrunkDrag(id,e.clientX,e.clientY)}
   cleanup();
  });
  handle.addEventListener('pointercancel',cleanup);
 }

