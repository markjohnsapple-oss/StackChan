 }
 async function readText(){const image=frame();if(!image){status('Camera is not ready.');return;}try{status('Reading text locally…');await script('https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js','Tesseract');ocrWorker=ocrWorker||await Tesseract.createWorker('eng');const result=await ocrWorker.recognize(image);const text=String(result.data?.text||'').trim();status(text||'I cannot read clear text in this view.');if(text)say('I can read: '+text.slice(0,260));}catch(e){status('Text reading failed: '+e.message)}}
