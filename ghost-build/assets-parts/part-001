 window.GhostEconomy={bowl:()=>state.bowl,finishBowl,status:()=>({coins:Math.floor(state.coins),hunger:state.hunger,energy:state.energy}),spend:(amount)=>{tick();amount=Math.floor(Number(amount));if(!Number.isFinite(amount)||amount<0||state.coins<amount)return false;state.coins-=amount;save();render();return true},earn:(amount)=>{tick();amount=Math.floor(Number(amount));if(!Number.isFinite(amount)||amount<0)return false;state.coins=Math.min(999999,state.coins+amount);save();render();return true},feedInstant:(name)=>{tick();const food=foods.find(f=>f.name===name);if(!food)return 0;const before=state.hunger;state.hunger=clamp(state.hunger+food.hunger);const gained=Math.max(0,Math.round(state.hunger-before));save();render();if(gained>0)toast(food.name+' caught! Hunger +'+gained+'.');window.dispatchEvent(new CustomEvent('ghost-food-eaten',{detail:{name:food.name,gained}}));return gained},serve:(name)=>{tick();const food=foods.find(f=>f.name===name);if(!food||state.bowl||state.sleepUntil)return false;state.bowl={name:food.name,hunger:food.hunger,at:Date.now()};save();render();window.dispatchEvent(new CustomEvent('ghost-food-purchased',{detail:{name}}));return true},returnBowl:()=>{tick();if(!state.bowl)return null;const name=state.bowl.name;state.bowl=null;save();render();window.dispatchEvent(new Event('ghost-food-eaten'));return name}};
