 function chatAttempt(e){
  if(internalClick)return;
  const input=document.querySelector('input[placeholder*="little dude"]');
  if(!input?.value.trim())return;
  tick();
  if(state.sleepUntil || state.energy<=0){
   e.preventDefault();e.stopImmediatePropagation();
   toast(state.sleepUntil?'Ghost is sleeping. Let him rest.':'Ghost needs sleep. Tap Sleep for a 15-minute rest.');return;
  }
  if(Date.now()-lastChatEvent<350)return;
