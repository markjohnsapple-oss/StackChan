<script id="ghost-chat-actions">
(()=>{
 const pad=n=>String(n).padStart(2,'0');
 const dateLabel=d=>d.toLocaleString(undefined,{weekday:'short',day:'numeric',month:'short',hour:'numeric',minute:'2-digit'});
 function parseReminder(text,now=new Date()){
   const raw=text.trim();if(!/^remind me\b/i.test(raw))return null;
   const time=raw.match(/\b(?:at\s*)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)\b/i);
   const relative=raw.match(/\b(today|tomorrow)\b/i);
   const calendar=raw.match(/\b(?:on\s+)?(\d{1,2})(?:st|nd|rd|th)?\s+(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)(?:\s+(\d{4}))?\b/i);
   if(!time||(!relative&&!calendar))return {error:'Please give me a date and an AM or PM time, like “Remind me to take medication tomorrow at 9am”.'};
   const hour=Number(time[1])%12+(time[3].toLowerCase()==='pm'?12:0),minute=Number(time[2]||0);
   if(Number(time[1])<1||Number(time[1])>12||minute>59)return {error:'That time does not look right. Try “tomorrow at 9am”.'};
   let date=new Date(now.getTime());date.setHours(hour,minute,0,0);
   if(relative){if(relative[1].toLowerCase()==='tomorrow')date.setDate(date.getDate()+1);}
   else{const months=['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'],month=months.indexOf(calendar[2].slice(0,3).toLowerCase()),day=Number(calendar[1]),year=calendar[3]?Number(calendar[3]):now.getFullYear();date=new Date(year,month,day,hour,minute);if(date.getMonth()!==month||date.getDate()!==day)return {error:'That date does not look right.'};if(!calendar[3]&&date<=now)date.setFullYear(year+1);}
   if(date<=now)return {error:'That time has passed. Tell me a future date and time.'};
   let label=raw.replace(/^remind me\s+(?:to|about|of)\s*/i,'').replace(time[0],'').replace(relative?.[0]||calendar?.[0]||'','').replace(/\b(?:on|at)\b/gi,'').replace(/\s+/g,' ').replace(/^[,\s]+|[,\s]+$/g,'').slice(0,180);
   if(!label||/^remind me\b/i.test(label))return {error:'What should I remind you about? Try “Remind me to take medication tomorrow at 9am”.'};
   return {label,date};
 }
 function intent(text){
   if(/^remind me\b/i.test(text))return {type:'reminder',parsed:parseReminder(text)};
   let m=text.match(/\b(?:where (?:did you|have you) (?:last )?see|where (?:was|were)|last (?:saw|seen))\s+(?:my |the )?(.+?)(?:\?|$)/i);
   if(m)return {type:'sighting',item:m[1].trim().replace(/[?.!]+$/,'')};
   m=text.match(/^(?:show me |find |what did i say |do you remember what i said )(?:what i said )?(?:about |on )?(.+?)(?:\?|$)/i);
   if(m){let query=m[1].trim().replace(/[?.!]+$/,'');const yesterday=/\byesterday\b/i.test(query);query=query.replace(/\byesterday\b/gi,'').replace(/\babout\b/gi,'').trim();return {type:'messages',query,yesterday};}
   return null;
 }
 async function remind(parsed){
   if(parsed.error)return parsed.error;
   const b=window.WebToApk;
   if(!b||typeof b.scheduleNotification!=='function')return 'I can prepare reminders, but phone notifications need Ghost installed through AppMint with Reminders access enabled. I have not set this one.';
   try{
     const permission=b.getNotificationPermission?.()||window.Notification?.permission;
     if(permission==='denied')return 'Notifications are blocked in your phone settings. I have not set the reminder.';
     if(permission!=='granted'&&(!window.Notification||await Notification.requestPermission()!=='granted'))return 'Notification permission is needed. I have not set the reminder.';
     const id='ghost-reminder-'+Date.now()+'-'+Math.random().toString(36).slice(2,8);
     if(!b.scheduleNotification(id,'Ghost reminder',parsed.label,String(parsed.date.getTime()),'none'))return 'The phone could not set that reminder. Check AppMint Reminders access.';
     return 'Done. I’ll remind you to '+parsed.label+' on '+dateLabel(parsed.date)+'.'+(b.getAlarmPrecision?.()==='inexact'?' Your phone may deliver it a little late.':'');
   }catch(e){return 'I could not set that reminder: '+e.message;}
 }
 async function sighting(item){
   await window.GhostMemory.ready;
   const rows=await window.GhostMemory.search('Visual observation',0);
   const tokens=item.toLowerCase().split(/\s+/).filter(x=>x.length>2);
   const found=rows.find(x=>tokens.some(word=>x.text.toLowerCase().includes(word)));
   if(!found)return 'I have no saved sighting of '+item+'. My camera needs to be on when I see it, and my guesses may be wrong.';
   return 'My last saved sighting: '+found.text.replace(/^Visual observation at /,'At ')+ ' Please check there; I may have mistaken the object.';
 }
 async function messages(query,yesterday){
   await window.GhostMemory.ready;
   if(!query||/^(this|that|it)$/i.test(query))return 'What should I search your messages for? Try “What did I say about pizza yesterday?”';
   let from=0,to=Infinity;
   if(yesterday){const d=new Date();d.setHours(0,0,0,0);to=d.getTime();d.setDate(d.getDate()-1);from=d.getTime();}
   const found=await window.GhostMemory.searchMessages(query,from,to);
   if(!found.length)return 'I could not find a message you sent about '+query+(yesterday?' yesterday':'')+'.';
   return 'You said'+(yesterday?' yesterday':'')+': “'+found.slice(0,2).map(x=>x.text.slice(0,220)).join('” and “')+'”';
 }
 async function act(request){
   if(request.type==='reminder')return remind(request.parsed);
   if(request.type==='sighting')return sighting(request.item);
   return messages(request.query,request.yesterday);
 }
 let busy=false,lastText='',lastAt=0;
 async function receive(e){
   const input=document.querySelector('input[placeholder*="little dude"]');if(!input)return;
   const send=e.type==='click'&&e.target.closest('button[aria-label="send"]');
   const enter=e.type==='keydown'&&e.key==='Enter'&&e.target===input;
   if(!send&&!enter)return;
   const text=input.value.trim(),request=intent(text);if(!request)return;
   e.preventDefault();e.stopImmediatePropagation();
   if(busy||text===lastText&&Date.now()-lastAt<500)return;
   busy=true;lastText=text;lastAt=Date.now();
   const setter=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value')?.set;
   if(setter)setter.call(input,'');else input.value='';input.dispatchEvent(new Event('input',{bubbles:true}));
   addGhostLog('you',text);
   try{const answer=await act(request);addGhostLog('ghost',answer);setBubble(answer,10000);}
   catch(err){const answer='I could not check that right now: '+err.message;addGhostLog('ghost',answer);setBubble(answer,10000);}
   finally{busy=false;}
 }
 document.addEventListener('keydown',receive,true);
 document.addEventListener('click',receive,true);
 window.GhostActions={parseReminder,intent};
})();
</script>
