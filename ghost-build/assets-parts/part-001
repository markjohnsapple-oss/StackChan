   if(name===lastGesture)gestureHits++;else{lastGesture=name;gestureHits=1;}if(gestureHits<2||Date.now()-lastGestureAt<90000)return;lastGestureAt=Date.now();gestureHits=0;
   if(name==='Open_Palm')say('Hi! I see you waving 👻');else if(name==='Thumb_Up')say('Thumbs up! Nice!');else if(name==='Pointing_Up')say('Are you showing me something? Tap Look now so I can check.');
