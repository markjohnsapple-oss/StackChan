<script id="ghost-memory-core">
(()=>{
 const DB='little_dude_memory_v1', MIGRATION='little_dude_memory_migrated_v1';
 let dbPromise;
 const open=()=>dbPromise||(dbPromise=new Promise((resolve,reject)=>{
   if(!window.indexedDB){reject(Error('This browser cannot save full memory'));return;}
    const req=indexedDB.open(DB,3);
    req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains('messages'))db.createObjectStore('messages',{keyPath:'id',autoIncrement:true});if(!db.objectStoreNames.contains('memories'))db.createObjectStore('memories',{keyPath:'id',autoIncrement:true});if(!db.objectStoreNames.contains('faces'))db.createObjectStore('faces',{keyPath:'id',autoIncrement:true});if(!db.objectStoreNames.contains('objects'))db.createObjectStore('objects',{keyPath:'id',autoIncrement:true});};
   req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);
 }));
 async function add(store,row){const db=await open();return new Promise((resolve,reject)=>{const tx=db.transaction(store,'readwrite');const req=tx.objectStore(store).add(row);req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});}
 async function all(store){const db=await open();return new Promise((resolve,reject)=>{const req=db.transaction(store,'readonly').objectStore(store).getAll();req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});}
 async function remove(store,id){const db=await open();return new Promise((resolve,reject)=>{const tx=db.transaction(store,'readwrite');const req=tx.objectStore(store).delete(id);req.onsuccess=()=>resolve();req.onerror=()=>reject(req.error);});}
 function words(text){return (String(text).toLowerCase().match(/[\p{L}\p{N}]{2,}/gu)||[]).slice(0,500);}
 function localVector(text){const v=new Array(256).fill(0);const w=words(text);for(const token of w){let h=2166136261;for(const c of token)h=Math.imul(h^c.charCodeAt(0),16777619);v[(h>>>0)%256]++;}return normalize(v);}
 function normalize(v){const n=Math.hypot(...v)||1;return v.map(x=>x/n);}
 function similarity(a,b){if(!a||!b||a.length!==b.length)return 0;let sum=0;for(let i=0;i<a.length;i++)sum+=a[i]*b[i];return sum;}
 async function embedding(text,key){
   if(!key)return null;
   try{const r=await window.GhostAPI.fetch('https://api.openai.com/v1/embeddings',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},body:JSON.stringify({model:'text-embedding-3-small',input:String(text).slice(0,3000)})});
     if(!r.ok)return null;const data=await r.json();const v=data.data?.[0]?.embedding;return Array.isArray(v)?normalize(v):null;
   }catch(e){return null;}
 }
 async function saveMessage(who,text){return add('messages',{who,text:String(text),at:Date.now()});}
  async function rememberPair(user,ghost,key){
   const text=`You: ${user}\nGhost: ${ghost}`;
   const vector=await embedding(text,key);
   return add('memories',{text,at:Date.now(),vector:vector||localVector(text),local:localVector(text),kind:vector?'semantic':'local'});
  }
  function transcriptText(name,raw){
    if(/\.json$/i.test(name)){
      let parsed;try{parsed=JSON.parse(raw);}catch(e){throw Error('Invalid JSON transcript');}
      const lines=[];
      function collect(value,depth=0){if(depth>12||value==null)return;if(typeof value==='string'){if(value.trim())lines.push(value.trim());return;}
        if(Array.isArray(value)){for(const part of value)collect(part,depth+1);return;}
        if(typeof value==='object'){const speaker=value.role||value.speaker||value.author||value.name;
          const content=value.content??value.text??value.transcript??value.body;
          if(typeof content==='string'){lines.push((speaker?String(speaker)+': ':'')+content);return;}
          for(const [key,part] of Object.entries(value))if(!['id','timestamp','created_at','metadata','time','start','end'].includes(key))collect(part,depth+1);
        }}
      collect(parsed);return lines.join('\n');
    }
    if(/\.(srt|vtt)$/i.test(name))return raw.replace(/^WEBVTT[^\n]*\n/gmi,'').replace(/^\s*\d+\s*$/gm,'').replace(/^.*-->.*$/gm,'').replace(/<[^>]*>/g,'');
    return raw;
  }
  function chunks(text){
    const paragraphs=text.replace(/\r\n?/g,'\n').split(/\n\s*\n/).map(p=>p.trim()).filter(Boolean);
    const out=[];let current='';
    for(const paragraph of paragraphs){for(let i=0;i<paragraph.length;i+=1200){
      const piece=paragraph.slice(i,i+1200);
      if(current&&current.length+piece.length>1500){out.push(current);current='';}
      current+=(current?'\n\n':'')+piece;
    }}
    if(current)out.push(current);return out;
  }
  async function importTranscript(file,onProgress){
    if(!/\.(txt|srt|vtt|json)$/i.test(file.name))throw Error('Choose a .txt, .srt, .vtt, or .json transcript');
    if(file.size>8*1024*1024)throw Error('This file is over 8 MB. Split it into smaller text files.');
    const text=transcriptText(file.name,await file.text()).trim();if(!text)throw Error('No readable text found');
    const parts=chunks(text),sourceId='transcript-'+Date.now()+'-'+Math.random().toString(36).slice(2);
    for(let i=0;i<parts.length;i++){
      const part=parts[i],local=localVector(part);
      await add('memories',{text:part,at:Date.now(),source:file.name,sourceId,section:i+1,vector:local,local,kind:'local'});
      if(i%10===0||i===parts.length-1){onProgress?.(i+1,parts.length);await new Promise(resolve=>setTimeout(resolve,0));}
    }
    return parts.length;
  }
