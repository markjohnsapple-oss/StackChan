  tick();if(state.sleepUntil){toast(`${Math.ceil((state.sleepUntil-Date.now())/60000)} minutes until Ghost is rested.`);return;}
  state.sleepStart=Date.now();state.sleepUntil=state.sleepStart+15*60000;state.updatedAt=state.sleepStart;save();render();window.dispatchEvent(new CustomEvent('ghost-sleep-started',{detail:{wakeAt:state.sleepUntil}}));
