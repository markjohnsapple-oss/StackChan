    method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
    body:JSON.stringify({model:'gpt-6-luna',instructions:'Reply as Little Dude in plain conversational text. Do not use Markdown, headings, bullet symbols, HTML tags, or decorative punctuation.',input:messages,store:false,max_output_tokens:256})
