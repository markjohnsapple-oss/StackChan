 const source=chatHistory.slice(1),pairs=[];
 for(let i=0;i<source.length-1;i++){
  if(source[i].role==='user'&&source[i+1].role==='assistant'){
   pairs.push([{role:'user',content:String(source[i].content).slice(0,1200)},{role:'assistant',content:String(source[i+1].content).slice(0,1200)}]);i++;
  }
 }
 const history=[];let budget=2600;
 for(const pair of pairs.slice(-6).reverse()){const size=pair[0].content.length+pair[1].content.length;if(size>budget)break;history.unshift(...pair);budget-=size}
