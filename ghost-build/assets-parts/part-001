   const options=lastDetections.slice(0,6),choices=options.map((o,i)=>i+1+': '+o.class).join('\n');let selected=null;
   if(options.length){const answer=prompt('Choose the object number, or 0 for the middle of the view:\n0: middle of view\n'+choices,'0');if(answer===null)return;selected=options[Number(answer)-1]||null;}
   const box=selected?.bbox||[source.width*.28,source.height*.2,source.width*.44,source.height*.6];const image=crop(source,box);
   try{status('Learning '+name.trim()+'…');const vector=await descriptor(image);await window.GhostMemory.saveObject(name.trim(),image.toDataURL('image/jpeg',.7),vector);status('I learned '+name.trim()+'. Show it from another angle and teach me again for better recognition.');}catch(e){status('Could not learn object: '+e.message)}
 }
 async function manage(){const items=await window.GhostMemory.objects();if(!items.length){status('No named objects yet.');return;}const names=items.map((x,i)=>i+1+': '+x.name).join('\n');const response=prompt('Named objects:\n'+names+'\nEnter a number to delete it, or Cancel to keep them.');if(response===null)return;const chosen=items[Number(response)-1];if(chosen&&confirm('Forget '+chosen.name+'?')){await window.GhostMemory.forgetObject(chosen.id);status('Forgot '+chosen.name+'.');}}
 async function history(){const rows=await window.GhostMemory.search('Visual observation',0);status(rows.length?rows.slice(0,5).map(x=>x.text).join('\n'):'No visual observations saved yet.');}
 async function askView(){const image=frame();if(!image){status('Camera is not ready.');return;}const question=prompt('Ask Ghost about what the camera sees:');if(!question?.trim())return;const key=window.GhostAPI?.key?.();if(!key){status('Turn API on and add a key in Settings to ask about the view.');return;}
   try{status('Thinking about the view…');const response=await window.GhostAPI.fetch('https://api.openai.com/v1/responses',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},body:JSON.stringify({model:'gpt-4.1-mini',store:false,max_output_tokens:220,input:[{role:'user',content:[{type:'input_text',text:question.trim()+' Answer briefly. If unsure, say so.'},{type:'input_image',image_url:image.toDataURL('image/jpeg',.65)}]}]})});const data=await response.json();if(!response.ok)throw Error(data.error?.message||'Request failed');const text=(data.output_text||(data.output||[]).flatMap(x=>x.content||[]).filter(x=>x.type==='output_text').map(x=>x.text).join('')).trim();status(text||'No answer came back.');if(text)say(text);}catch(e){status('View question failed: '+e.message)}
 }
 function button(label,action){const b=document.createElement('button');b.type='button';b.textContent=label;b.onclick=action;return b;}
 function onStart(theCard,theRow){card=theCard;row=theRow;video=card.querySelector('video');row.prepend(button('Read text',readText),button('Teach item',teach),button('My items',manage),button('Saw earlier',history),button('Ask view (online)',askView));
   setTimeout(()=>{if(card?.isConnected)loadGesture().then(()=>status('Hand gestures ready: wave, point, or thumbs up.')).catch(e=>status('Gestures unavailable: '+e.message))},7000);
   window.GhostMemory?.ready.then(()=>window.GhostMemory.objects()).then(items=>{if(items.length&&card?.isConnected)loadMobile().catch(e=>status('Named object model unavailable: '+e.message))}).catch(()=>{});
