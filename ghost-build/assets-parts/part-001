  else if(name.endsWith('Sleep')||name.endsWith('Wake')){e.preventDefault();e.stopImmediatePropagation();sleep();}
 },true);
 document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.matches('input[placeholder*="little dude"]'))chatAttempt(e);},true);
 setInterval(tick,5000);
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{tick();if(state.sleepUntil)setTimeout(()=>clickOriginal(findButton('Sleep')),1300);});
 else {tick();if(state.sleepUntil)setTimeout(()=>clickOriginal(findButton('Sleep')),1300);}
})();
