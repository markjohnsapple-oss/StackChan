 .ghost-composer-row { margin-top:12px; margin-bottom:0; }
 .ghost-composer-row > p { display:none; }
 body.ghost-keyboard-open .ghost-app { position:fixed; z-index:20; left:0; top:var(--ghost-vv-top,0px); width:100%; height:var(--ghost-vv-height,260px); min-height:0; padding:34px 12px 6px; justify-content:flex-end; background:#f6f1e9; }
 body.ghost-keyboard-open .ghost-logo,
 body.ghost-keyboard-open .ghost-status-row,
 body.ghost-keyboard-open .ghost-actions-row { display:none; }
      body.ghost-keyboard-open .ghost-bubble-row { height:24px; flex:none; margin-bottom:0; }
 body.ghost-keyboard-open .ghost-avatar-row { flex:none; margin:0 auto 4px; }
      body.ghost-keyboard-open .ghost-avatar-row > div:nth-child(2) > div { width:76px !important; height:76px !important; border-width:4px !important; }
 body.ghost-keyboard-open .ghost-avatar-row > div:first-child { display:none; }
 body.ghost-keyboard-open .ghost-composer-row { flex:none; margin:0; }
