  .replace(/(?:\([^()\n]{0,240}\)|\[[^\[\]\n]{0,240}\])/g,part=>/\b(?:waves?|floats?|nods?|smiles?|grins?|giggles?|laughs?|chuckles?|blinks?|glows?|twitches?|shrugs?|sighs?|gestures?|tilts?|hugs?|whispers?|pauses?|looks?|walks?|moves?|leans?|bounces?|yawns?)\b/i.test(part)?' ':part)
