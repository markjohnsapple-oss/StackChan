 .ghost-logo { margin:0 0 4px !important; height:72px; align-items:center; }
 .ghost-logo img { width:auto !important; max-width:285px !important; max-height:72px; object-fit:contain; }
 .ghost-bubble-row { height:54px; margin-bottom:2px; }
 .ghost-avatar-row { margin-top:2px; }
 .ghost-avatar-row > div:nth-child(2) > div { width:min(57vw,225px) !important; height:min(57vw,225px) !important; border-width:9px !important; }
 .ghost-status-row { margin-top:10px; }
 .ghost-actions-row { margin-top:10px; gap:8px; }
