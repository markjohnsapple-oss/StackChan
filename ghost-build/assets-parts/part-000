<style id="ghost-log-style">
#ghost-chat-log { box-sizing:border-box; width:100%; height:190px; overflow-y:auto; background:#fffdf8; border:2px solid #222; border-radius:14px; padding:8px; font:12px/1.35 system-ui; box-shadow:3px 4px 0 #222; overflow-wrap:anywhere; }
#ghost-chat-log .log-title { font-weight:800; border-bottom:1px solid #ddd; padding-bottom:4px; margin-bottom:5px; }
#ghost-chat-log .log-entry { margin:6px 0; }
#ghost-chat-log .log-entry strong { display:block; }
#ghost-chat-log .log-entry.you strong { color:#714ca2; }
#ghost-chat-log .log-entry.ghost strong { color:#297048; }
@media (max-width:1000px) {
 .ghost-avatar-row { width:min(94vw,620px); display:grid; grid-template-columns:min(57vw,225px) minmax(0,1fr); align-items:center; gap:8px; }
 .ghost-avatar-row > div:nth-child(2) { grid-column:1; }
