<script id="ghost-native-ble-shim">
/* Ghost 3.0.4 Android WebView Bluetooth compatibility layer.
   Only active inside the separately packaged native Android application. */
(function(){
'use strict';
if(!window.GhostAndroid)return;
let sequence=1, pendingScan=null, devices=new Map(),pendingConnect=new Map(),pendingWrite=new Map();
class PalDevice{
  constructor(id,name){this.id=id;this.name=name||'Ghost-PocketPal';this._listeners={};
   this.gatt={connected:false,connect:()=>new Promise((resolve,reject)=>{
     const n=String(sequence++);pendingConnect.set(n,{resolve:()=>{this.gatt.connected=true;resolve({getPrimaryService:async()=>({getCharacteristic:async(uuid)=>new PalCharacteristic(uuid)})});},reject});
     window.GhostAndroid.connect(this.id,n);
   })};
  }
  addEventListener(name,cb){(this._listeners[name]??=[]).push(cb)}
  dispatch(name){for(const callback of (this._listeners[name]||[]))try{callback({target:this})}catch(e){console.error(e)}}
}
class PalCharacteristic{
  constructor(uuid){this.uuid=uuid;this._listeners={};if(uuid.startsWith('c9000003'))window.__palNotify=this;}
  addEventListener(name,cb){(this._listeners[name]??=[]).push(cb)}
  async startNotifications(){return this;}
  async writeValueWithResponse(data){
    const bytes=new Uint8Array(data.buffer||data,data.byteOffset||0,data.byteLength||data.length);
    let binary='';for(let i=0;i<bytes.length;i++)binary+=String.fromCharCode(bytes[i]);
    const n=sequence++;
    return new Promise((resolve,reject)=>{
      pendingWrite.set(String(n),{resolve,reject});window.GhostAndroid.write(btoa(binary),n);
    });
  }
  writeValue(data){return this.writeValueWithResponse(data)}
}
function asDevice(id,name){
 if(!devices.has(id))devices.set(id,new PalDevice(id,name));
 return devices.get(id);
}
window.__nativeFound=(id,name)=>{if(pendingScan){let p=pendingScan;pendingScan=null;p.resolve(asDevice(id,name));}};
window.__nativeScanFailed=(message)=>{if(pendingScan){let p=pendingScan;pendingScan=null;p.reject(Error(message));}};
window.__nativeConnectResult=(id,error)=>{
 const p=pendingConnect.get(String(id));if(!p)return;pendingConnect.delete(String(id));
 if(error)p.reject(Error(error));else p.resolve();
};
window.__nativeBleWriteComplete=(id,error)=>{
 const p=pendingWrite.get(String(id));if(!p)return;pendingWrite.delete(String(id));
 if(error)p.reject(Error(error));else p.resolve();
};
window.__nativeBleNotify=base64=>{
 const char=window.__palNotify;if(!char)return;
 const binary=atob(base64),bytes=new Uint8Array(binary.length);
 for(let i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);
 const event={target:{value:new DataView(bytes.buffer)}};
 for(const f of (char._listeners['characteristicvaluechanged']||[]))try{f(event)}catch(e){console.error(e)}
};
window.__nativeDisconnected=()=>{
 for(const d of devices.values())if(d.gatt.connected){d.gatt.connected=false;d.dispatch('gattserverdisconnected')}
 for(const p of pendingWrite.values())p.reject(Error('Bluetooth disconnected'));pendingWrite.clear();
};
const bt={
 requestDevice:()=>new Promise((resolve,reject)=>{
   if(pendingScan){reject(Error('Already searching for Pocket Pal'));return;}
   pendingScan={resolve,reject};window.GhostAndroid.scan();
 }),
 getDevices:async()=>{
   try{const saved=JSON.parse(window.GhostAndroid.savedDevice()||'null');return saved?.id?[asDevice(saved.id,saved.name)]:[];}
   catch(e){return []}
 }
};
try{Object.defineProperty(navigator,'bluetooth',{configurable:true,value:bt});}
catch(e){console.error('Ghost Android Bluetooth shim failed:',e)}
})();

</script>
